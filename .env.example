# Instructions: Copy this file to .env and fill in the values for your environment.

# Database Credentials
DB_USER=ticketapp_user
DB_PASSWORD=strong_db_password

# Keycloak Admin Credentials
KC_ADMIN_USER=ticketapp_admin
KC_ADMIN_PASSWORD=strong_admin_password

# Keycloak Service Account (Client Credentials)
KC_SERVER_URL=http://localhost:8081
KC_REALM=ticketapp
KC_CLIENT_ID=ticketapp-backend
KC_CLIENT_SECRET=backend_service_secret

#MinIO Object Storage Credentials
MINIO_ACCESS_KEY=ticketapp_minio_user
MINIO_SECRET_KEY=strong_minio_password

